{
  "manifest_version": 3,
  "name": "Download Selected Tabs as PDFs",
  "version": "1.0.0",
  "description": "Select several tabs (Shift/Cmd-click), then download every PDF among them in one go.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download selected tabs as PDFs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "download-selected-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download selected tabs as PDFs"
    }
  },
  "permissions": ["tabs", "downloads", "contextMenus", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
